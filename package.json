{
  "name": "scrypted-aiphone",
  "version": "0.1.21",
  "description": "Aiphone WP-2MED video doorbell integration for Scrypted",
  "license": "MIT",
  "main": "dist/main.nodejs.js",
  "keywords": [
    "scrypted",
    "plugin",
    "aiphone",
    "doorbell"
  ],
  "scripts": {
    "build": "NODE_ENV=production scrypted-webpack && node scripts/licenses.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "scrypted-deploy": "NODE_ENV=production scrypted-deploy",
    "prepack": "npm run typecheck && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.cjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke && npm audit",
    "prepublishOnly": "npm run check"
  },
  "scrypted": {
    "name": "Aiphone WP-2MED",
    "type": "DeviceProvider",
    "interfaces": [
      "DeviceProvider",
      "Settings",
      "Readme"
    ],
    "rollup": true
  },
  "dependencies": {
    "mqtt": "5.15.1",
    "werift": "0.25.2"
  },
  "devDependencies": {
    "@scrypted/sdk": "0.5.59",
    "@types/node": "^20.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "files": [
    "dist/plugin.zip",
    "dist/main.nodejs.js",
    "dist/main.nodejs.js.map",
    "dist/THIRD_PARTY_LICENSES.txt",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "aureole999",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aureole999/scrypted-aiphone.git"
  },
  "homepage": "https://github.com/aureole999/scrypted-aiphone#readme",
  "bugs": {
    "url": "https://github.com/aureole999/scrypted-aiphone/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "serialize-javascript": "7.1.4"
  }
}
